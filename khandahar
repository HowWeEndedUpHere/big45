    if ($result->num_rows > 0) {
        while($row = $result->fetch_assoc()) {

            // Check recall status (assuming 1 = recalled, 0 = safe)
            $status = $row['recalled'] ? 
                "<span class='recalled'>Recalled</span>" : 
                "Available";

            echo "<tr>
                    <td>{$row['product']}</td>
                    <td>{$row['stock']}</td>
                    <td>{$row['price']}</td>
                    <td>$status</td>
                  </tr>";
        }
    } else {
        echo "<tr><td colspan='4'>No products found</td></tr>";
    }

    $conn->close();
    ?>

