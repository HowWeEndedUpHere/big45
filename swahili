<?php
$conn = new mysqli("localhost", "root", "", "your_database");

$customer_id = 1; // Example (replace with session)

// Get cart items with price
$sql = "SELECT c.product_id, c.quantity, i.price 
        FROM cart c
        JOIN inventory i ON c.product_id = i.product_id
        WHERE c.customer_id = ?";

$stmt = $conn->prepare($sql);
$stmt->bind_param("i", $customer_id);
$stmt->execute();
$result = $stmt->get_result();

// Insert into orders
$insert = $conn->prepare("INSERT INTO orders (product_id, customer_id, quantity, cost, completed) VALUES (?, ?, ?, ?, ?)");

$completed = 0;

while ($row = $result->fetch_assoc()) {
    $product_id = $row['product_id'];
    $quantity = $row['quantity'];
    $price = $row['price'];

    $cost = $price * $quantity;

    $insert->bind_param("iiidi", $product_id, $customer_id, $quantity, $cost, $completed);
    $insert->execute();
}

// OPTIONAL: clear cart after order
$clear = $conn->prepare("DELETE FROM cart WHERE customer_id = ?");
$clear->bind_param("i", $customer_id);
$clear->execute();

echo "Order placed successfully!";
?>